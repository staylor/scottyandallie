server {
	listen       80;
	server_name  scottyandallie.com *.scottyandallie.com;
	root         /var/www/scottyandallie.com/public_html;
	access_log   /var/www/scottyandallie.com/logs/access.log;
	error_log    /var/www/scottyandallie.com/logs/error.log;
  location /.well-known/acme-challenge/ {
    try_files $uri /dev/null =404;
  }
	location / {
		rewrite ^ https://scottyandallie.com$request_uri permanent;
	}
}

server {
	listen 443;
	ssl on;
	server_name  scottyandallie.com;
	root         /var/www/scottyandallie.com/public_html/static;
	access_log   /var/www/scottyandallie.com/logs/ssl.access.log;
	error_log    /var/www/scottyandallie.com/logs/ssl.error.log;
	index index.php index.html; 

	# Directives to send expires headers and turn off 404 error logging.
	location ~* \.(js|css|png|jpg|jpeg|gif|ico)$ {
    expires 24h;
    log_not_found off;
	}

	# this prevents hidden files (beginning with a period) from being served
  	location ~ /\.  { access_log off; log_not_found off; deny all; }
}
